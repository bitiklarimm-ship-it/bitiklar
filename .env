# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=www.bitiklar.uz
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# Saytning tashqi manzillari
# Bitta serverli rejim: hammasi shu manzilda (FRONTEND_URL/BACKEND_PUBLIC_URL bo'sh bo'lsa shundan olinadi)
SITE_URL=https://bitiklar.onrender.com
FRONTEND_URL=https://bitiklar.onrender.com
BACKEND_PUBLIC_URL=https://bitiklar.onrender.com

# Postgres (docker-compose o'zi DATABASE_URL beradi; Render'da Render beradi)
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://bitiklar_user:lAMNh6S6WPnfyxxXgfXUPrdb03O86bl3@dpg-dc2popcs728c73ba4nrg-a/bitiklar

# Birinchi ishga tushirishda admin yaratish
DJANGO_SUPERUSER_USERNAME=Crezza_2008
DJANGO_SUPERUSER_EMAIL=bitiklarimm@gmail.com
DJANGO_SUPERUSER_PASSWORD=Crezza_2008
# Demo obida va bitiklarni kiritish (1 = ha)
SEED_DEMO=1

# --- Rasmlar: r2 | local | s3 | cloudinary ---
STORAGE_BACKEND=r2
# Cloudflare R2 (Dashboard > R2 > Manage R2 API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bitiklar-media
# Bucketga ulangan ommaviy domen (https:// siz), masalan: media.bitiklar.uz yoki pub-xxxx.r2.dev
R2_PUBLIC_DOMAIN=media.bitiklar.uz
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=

# --- AI tahlil (ixtiyoriy) ---
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-5-5

# --- Frontend ---
# Bo'sh = brauzer API'ga shu domenning o'zidan murojaat qiladi
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=https://bitiklar.uz

# --- Email xabarnomalar (ixtiyoriy; bo'sh bo'lsa xatlar faqat logga chiqadi) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=BITIKLAR <noreply@bitiklar.uz>

# --- Zaxira nusxa ---
# R2'dagi ALOHIDA, yopiq bucket (ommaviy media bucketi emas!). Bo'sh bo'lsa server diskiga yoziladi
BACKUP_BUCKET=
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24

# --- Xatolarni kuzatish (ixtiyoriy) ---
SENTRY_DSN=
