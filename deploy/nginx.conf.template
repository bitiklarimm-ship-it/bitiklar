# start.sh bu faylni envsubst orqali ${PORT} bilan to'ldiradi
upstream django { server 127.0.0.1:8000; keepalive 16; }
upstream nextjs { server 127.0.0.1:3000; keepalive 16; }

# Render/Cloudflare oldidagi proksi https yuborgan bo'lsa, shuni saqlaymiz
map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen ${PORT} default_server;
    server_name _;

    client_max_body_size 50m;      # rasm va audio yuklash uchun
    proxy_read_timeout 180s;       # AI tahlil uzoq davom etishi mumkin

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $fwd_proto;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Django: API, admin panel, admin statikasi, media
    location /api/    { proxy_pass http://django; }
    location /admin   { proxy_pass http://django; }
    location /static/ { proxy_pass http://django; expires 30d; }
    location /media/  { proxy_pass http://django; expires 7d; }

    # Next.js: qolgan barcha sahifalar
    location / { proxy_pass http://nextjs; }
}
